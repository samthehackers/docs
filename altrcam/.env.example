# --- Supabase Auth (browser + server). The Vercel Supabase integration sets these. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name, used only when the publishable key is unset:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "true" shows "Continue with Google". Enable the Google provider in Supabase first.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# --- Database (server only). First one set wins: DATABASE_URL, POSTGRES_URL, POSTGRES_PRISMA_URL. ---
# The integration sets POSTGRES_URL (transaction pooler) and POSTGRES_URL_NON_POOLING (used by db:migrate).
DATABASE_URL=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# --- Supabase server-side (Storage, deleting the Auth user). Never expose these to the browser. ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy name, used only when SUPABASE_SECRET_KEY is unset:
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional integrations: each feature says it's unavailable while its keys are missing. ---
FAL_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PLAN_PRO_MONTHLY=
PAYSTACK_PLAN_PRO_YEARLY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PRICES ARE PLACEHOLDERS until the owner approves real ones. Minor units (kobo for NGN, cents for USD).
# While PRICING_APPROVED is not "true", the pricing and billing pages show a "pricing is not final" notice.
PRICING_APPROVED=false
PRICE_CURRENCY=NGN
PRICE_PRO_MONTHLY=1500000
PRICE_PRO_YEARLY=15000000
PRICE_LIFETIME=45000000
PRICE_TOPUP_1K=300000
PRICE_TOPUP_5K=1200000
PRICE_TOPUP_15K=3000000
EMAIL_FROM="AltrCam <hello@altrcam.com>"

PAYSTACK_API_URL=https://api.paystack.co

# Shown on the public Contact page (defaults to support@altrcam.com; make sure someone reads it)
NEXT_PUBLIC_SUPPORT_EMAIL=support@altrcam.com
