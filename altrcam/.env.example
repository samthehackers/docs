NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FAL_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PLAN_PRO_MONTHLY=
PAYSTACK_PLAN_PRO_YEARLY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PRICES: minor units (kobo for NGN, cents for USD). Card (Paystack) charges the _NGN price; crypto (NOWPayments) the _USD one.
# Left empty on purpose: a product with no price is hidden and checkout refuses it. Set them only to prices you have decided.
# While PRICING_APPROVED is not "true", the pricing and billing pages show a "pricing is not final" notice.
# See GO_LIVE.md, "Pricing and payment variables".
PRICING_APPROVED=false
PRICE_PRO_MONTHLY_NGN=
PRICE_PRO_MONTHLY_USD=
PRICE_PRO_YEARLY_NGN=
PRICE_PRO_YEARLY_USD=
PRICE_LIFETIME_NGN=
PRICE_LIFETIME_USD=
PRICE_TOPUP_1K_NGN=
PRICE_TOPUP_1K_USD=
PRICE_TOPUP_5K_NGN=
PRICE_TOPUP_5K_USD=
PRICE_TOPUP_15K_NGN=
PRICE_TOPUP_15K_USD=
EMAIL_FROM="AltrCam <hello@altrcam.com>"

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
PAYSTACK_API_URL=https://api.paystack.co

# Shown on the public Contact page (defaults to support@altrcam.com; make sure someone reads it)
NEXT_PUBLIC_SUPPORT_EMAIL=support@altrcam.com
