NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FAL_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PLAN_PRO_MONTHLY=
PAYSTACK_PLAN_PRO_YEARLY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The sign-up switch: "true" opens sign-up when both Clerk keys and DATABASE_URL are also set; "false" or unset keeps it closed.
# A Vercel Production build with "true" and a missing credential fails on purpose. See docs/SETUP.md.
SIGNUPS_OPEN=false

# PRICES ARE PLACEHOLDERS until the owner approves real ones. Minor units (kobo for NGN, cents for USD).
# While PRICING_APPROVED is not "true", the pricing and billing pages show a "pricing is not final" notice.
PRICING_APPROVED=false
PRICE_CURRENCY=NGN
PRICE_PRO_MONTHLY=1500000
PRICE_PRO_YEARLY=15000000
PRICE_LIFETIME=45000000
PRICE_TOPUP_1K=300000
PRICE_TOPUP_5K=1200000
PRICE_TOPUP_15K=3000000
EMAIL_FROM="AltrCam <hello@altrcam.com>"

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
PAYSTACK_API_URL=https://api.paystack.co

# Shown on the public Contact page (defaults to support@altrcam.com; make sure someone reads it)
NEXT_PUBLIC_SUPPORT_EMAIL=support@altrcam.com
